# ============ SERVIDOR ============
PORT=8080
# Interface onde o servidor escuta. 0.0.0.0 = todas as interfaces (permite acesso externo)
HOST=0.0.0.0
# Host:porta que o CLIENTE usa no player. Em producao coloque seu dominio/IP publico.
# Ex.: PUBLIC_URL=http://129.213.129.0:8080  (servidor de producao)
PUBLIC_URL=http://localhost:8080

# ============ SEGURANCA ============
# Troque por uma string aleatoria longa (npm run setup gera uma automaticamente)
JWT_SECRET=troque-esta-chave
# Sessao do painel (horas)
SESSION_HOURS=12

# ============ STREAMING ============
# redirect = 302 para a fonte (nao gasta banda)  |  proxy = servidor repassa o video
STREAM_MODE=redirect
# Timeout ao conectar na fonte em modo proxy (ms)
PROXY_TIMEOUT=15000
# Segundos sem heartbeat para considerar a conexao encerrada
CONNECTION_TTL=90

# ============ BANCO ============
DB_PATH=./data/panel.db

# ============ PADROES ============
# Duracao do teste gratis em horas
TRIAL_HOURS=6
